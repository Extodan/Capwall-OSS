{
  "name": "@extodan/capwall",
  "version": "0.2.0",
  "description": "capwall \u2014 capability firewall for npm dependencies: scan, lock, enforce, attest.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "capwall": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@extodan/capwall-attestation": "workspace:*",
    "@extodan/capwall-core": "workspace:*",
    "@extodan/capwall-runtime-node": "workspace:*",
    "@extodan/capwall-scanner": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "@extodan/capwall-agent-shield": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "security",
    "supply-chain",
    "npm",
    "permissions",
    "capabilities",
    "runtime",
    "sandbox",
    "mcp",
    "ai-agents",
    "firewall",
    "in-toto"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Extodan/Capwall-OSS.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Extodan/Capwall-OSS#readme",
  "bugs": {
    "url": "https://github.com/Extodan/Capwall-OSS/issues"
  }
}
