{
  "name": "capwall",
  "private": true,
  "description": "Capability firewall for npm dependencies \u2014 Android-style runtime permissions for node_modules.",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "e2e": "bash scripts/e2e.sh",
    "sim:demo": "node packages/exploit-sim-lab/dist/cli.mjs",
    "demo:attack": "cd examples/zero-day-hijack-demo && npm run demo:attack"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "dotenv": "^16.4.5"
  }
}