{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Capwall capabilities.lock",
  "type": "object",
  "required": ["version", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "properties": {
        "unrecognized": { "enum": ["block", "warn", "allow"], "default": "warn" }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "enum": [
                "env.read",
                "env.write",
                "child_process",
                "net.connect",
                "net.listen",
                "http.request",
                "dns.resolve",
                "fs.read",
                "fs.write",
                "dynamic-code",
                "worker_threads"
              ]
            }
          },
          "onViolation": { "enum": ["block", "warn"] },
          "source": { "enum": ["scan", "manual", "template"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
